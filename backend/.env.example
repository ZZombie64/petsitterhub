# Copia questo file in ".env" e compila i valori.
# ".env" non va mai committato (è già nel .gitignore).

# Connessione al database (deve combaciare con docker-compose.yml)
DATABASE_URL=postgresql://petsitter:petsitter@localhost:5432/petsitterhub

# Porta su cui gira il backend
PORT=3000

# Segreto usato per firmare i token JWT.
# In locale puoi mettere una stringa qualsiasi, lunga e casuale.
JWT_SECRET=cambia_questa_stringa_con_qualcosa_di_lungo_e_casuale

# Per quanto tempo resta valido il token dopo il login
JWT_EXPIRES_IN=7d

# Chiave segreta Stripe in modalità test (dashboard.stripe.com > Sviluppatori > Chiavi API)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Indirizzo del frontend, usato per i redirect dopo il pagamento Stripe
FRONTEND_URL=http://localhost:5173

# Account Gmail usato per inviare l'email di conferma pagamento.
# EMAIL_PASSWORD è una "password per le app" generata su
# myaccount.google.com/apppasswords, NON la password normale di Gmail.
EMAIL_USER=tuo.indirizzo@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
